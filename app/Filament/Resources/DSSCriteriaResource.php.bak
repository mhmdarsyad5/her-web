<?php

namespace App\Filament\Resources;

use App\Filament\Resources\DSSCriteriaResource\Pages;
use App\Filament\Resources\DSSCriteriaResource\RelatedActionsResource;
use App\Models\DSSCriteria;
use Filament\Forms;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;

class DSSCriteriaResource extends Resource
{
    protected static ?string $model = DSSCriteria::class;

    protected static ?string $label = 'DSS Criteria';

    protected static ?string $pluralLabel = 'DSS Criteria (Form Options)';

    public static function form(Form $form): Form
    {
        return $form
            ->schema([
                Forms\Components\Section::make('Basic Information')
                    ->schema([
                        Forms\Components\Select::make('field_type')
                            ->label('Field Type')
                            ->options([
                                'location' => 'Location (Lokasi)',
                                'industry' => 'Industry (Industri)',
                                'cargo_type' => 'Cargo Type (Jenis Barang)',
                                'weight' => 'Weight Range (Berat)',
                                'height' => 'Height (Ketinggian)',
                                'aisle' => 'Aisle Width (Lebar Lorong)',
                                'energy' => 'Energy Source (Energi)',
                                'unit' => 'Current Unit (Unit Sekarang)',
                                'operator' => 'Operator Position (Posisi Operator)',
                            ])
                            ->required()
                            ->native(false),

                        Forms\Components\TextInput::make('code')
                            ->label('Code (Unique Identifier)')
                            ->required()
                            ->unique(table: 'dss_criteria', ignorable: fn($record) => $record)
                            ->helperText('Simple code like "indoor", "lithium", "1to3t"')
                            ->disabled(fn($operation) => $operation === 'edit'),

                        Forms\Components\TextInput::make('name')
                            ->label('Name (Indonesian)')
                            ->required()
                            ->maxLength(255)
                            ->helperText('Display name that appears in the form'),

                        Forms\Components\TextInput::make('sort_order')
                            ->label('Sort Order')
                            ->numeric()
                            ->default(0),

                        Forms\Components\Toggle::make('is_active')
                            ->label('Active')
                            ->default(true),
                    ])
                    ->columns(2),

                Forms\Components\Section::make('Equipment Mapping (Optional)')
                    ->description('Advanced: Maps this criteria to equipment specifications for filtering')
                    ->schema([
                        Forms\Components\CodeEditor::make('equipment_map')
                            ->language('json')
                            ->label('Equipment Map (JSON)')
                            ->helperText('Example: {"spec_field":"energy","operator":"=","value":"lithium"}')
                            ->columnSpan('full'),
                    ]),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                Tables\Columns\TextColumn::make('field_type')
                    ->label('Field Type')
                    ->badge()
                    ->color(fn($record) => match($record->field_type) {
                        'location' => 'blue',
                        'industry' => 'green',
                        'cargo_type' => 'yellow',
                        'weight' => 'orange',
                        'height' => 'purple',
                        'aisle' => 'pink',
                        'energy' => 'red',
                        'unit' => 'indigo',
                        'operator' => 'cyan',
                        default => 'gray',
                    })
                    ->sortable(),

                Tables\Columns\TextColumn::make('code')
                    ->label('Code')
                    ->searchable()
                    ->sortable(),

                Tables\Columns\TextColumn::make('name')
                    ->label('Name')
                    ->searchable()
                    ->sortable()
                    ->limit(50),

                Tables\Columns\IconColumn::make('is_active')
                    ->label('Active')
                    ->boolean()
                    ->sortable(),

                Tables\Columns\TextColumn::make('sort_order')
                    ->label('Order')
                    ->numeric()
                    ->sortable(),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('field_type')
                    ->label('Field Type')
                    ->options([
                        'location' => 'Location',
                        'industry' => 'Industry',
                        'cargo_type' => 'Cargo Type',
                        'weight' => 'Weight',
                        'height' => 'Height',
                        'aisle' => 'Aisle',
                        'energy' => 'Energy',
                        'unit' => 'Unit',
                        'operator' => 'Operator',
                    ]),

                Tables\Filters\TernaryFilter::make('is_active')
                    ->label('Active'),
            ])
            ->actions([
                Tables\Actions\EditAction::make(),
                Tables\Actions\DeleteAction::make(),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                ]),
            ])
            ->defaultSort('field_type', 'sort_order');
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListDSSCriteria::route('/'),
            'create' => Pages\CreateDSSCriteria::route('/create'),
            'edit' => Pages\EditDSSCriteria::route('/{record}/edit'),
        ];
    }
}
