<?php

namespace App\Filament\Resources;

use App\Filament\Resources\DSSRuleResource\Pages;
use App\Models\DSSRule;
use Filament\Forms;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;

class DSSRuleResource extends Resource
{
    protected static ?string $model = DSSRule::class;

    protected static ?string $label = 'DSS Rule';

    protected static ?string $pluralLabel = 'DSS Rules';

    public static function form(Form $form): Form
    {
        return $form
            ->schema([
                Forms\Components\Section::make('Basic Information')
                    ->schema([
                        Forms\Components\TextInput::make('name')
                            ->label('Rule Name')
                            ->required()
                            ->maxLength(255)
                            ->helperText('Example: "Lithium Indoor Forklift 1-3t"'),

                        Forms\Components\Select::make('equipment_id')
                            ->label('Equipment')
                            ->relationship('equipment', 'name')
                            ->searchable()
                            ->required()
                            ->helperText('Select the equipment this rule recommends'),

                        Forms\Components\TextInput::make('priority')
                            ->label('Priority')
                            ->numeric()
                            ->default(0)
                            ->helperText('Higher priority = better match (0-100)'),

                        Forms\Components\TextInput::make('relevance_score')
                            ->label('Relevance Score')
                            ->numeric()
                            ->default(100)
                            ->helperText('Weight for ranking (0-100)'),

                        Forms\Components\Toggle::make('is_active')
                            ->label('Active')
                            ->default(true),
                    ])
                    ->columns(2),

                Forms\Components\Section::make('Rule Conditions')
                    ->description('Define which user inputs match this rule')
                    ->schema([
                        Forms\Components\CodeEditor::make('conditions')
                            ->language('json')
                            ->label('Conditions (JSON)')
                            ->required()
                            ->helperText(<<<'EOH'
                            Example:
                            {
                              "location": ["indoor", "outdoor"],
                              "energy": "lithium",
                              "weight": "1to3t",
                              "operator": ["seated", "standing"]
                            }

                            Supported fields: location, industry, cargo_type, weight, height, aisle, energy, unit, operator
                            EOH
                            )
                            ->columnSpan('full')
                            ->minHeight('300px'),
                    ]),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                Tables\Columns\TextColumn::make('name')
                    ->label('Rule Name')
                    ->searchable()
                    ->sortable()
                    ->limit(50),

                Tables\Columns\TextColumn::make('equipment.name')
                    ->label('Equipment')
                    ->searchable()
                    ->sortable()
                    ->limit(50),

                Tables\Columns\TextColumn::make('priority')
                    ->label('Priority')
                    ->badge()
                    ->color(fn($record) => $record->priority >= 75 ? 'success' : ($record->priority >= 50 ? 'warning' : 'info'))
                    ->numeric()
                    ->sortable(),

                Tables\Columns\TextColumn::make('relevance_score')
                    ->label('Relevance')
                    ->numeric()
                    ->sortable(),

                Tables\Columns\IconColumn::make('is_active')
                    ->label('Active')
                    ->boolean()
                    ->sortable(),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('equipment_id')
                    ->label('Equipment')
                    ->relationship('equipment', 'name'),

                Tables\Filters\TernaryFilter::make('is_active')
                    ->label('Active'),

                Tables\Filters\Filter::make('priority_high')
                    ->label('High Priority (>= 50)')
                    ->query(fn($query) => $query->where('priority', '>=', 50)),
            ])
            ->actions([
                Tables\Actions\EditAction::make(),
                Tables\Actions\DeleteAction::make(),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                ]),
            ])
            ->defaultSort('priority', 'desc');
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListDSSRules::route('/'),
            'create' => Pages\CreateDSSRule::route('/create'),
            'edit' => Pages\EditDSSRule::route('/{record}/edit'),
        ];
    }
}
